generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  username        String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  refreshTokens RefreshToken[]
  runs          Run[]
}

model Run {
  id                String   @id @default(cuid())
  userId            String
  title             String
  language          String
  // CP problem the user is solving. Nullable for legacy pre-pivot runs; required at the API layer for new ones.
  problemStatement  String?
  code              String // original input the user submitted
  finalCode         String // surfaced as the "improved" result
  maxIterations     Int
  iterationsRun     Int
  terminationReason String
  finalScore        Int? // last evaluator's scores.overall; null if no iterations
  // finalCode's sandbox pass-rate (0–100), denormalized for sidebar listing. Null on legacy runs or a skipped sandbox.
  testPassRate      Int?
  // Single end-of-loop Evaluator verdict (EvaluatorOutputT). Evaluator runs once at the end, not per iteration. Null on legacy/fallback runs.
  finalEvaluation   Json?
  createdAt         DateTime @default(now())
  completedAt       DateTime

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  iterations  Iteration[]
  testCases   TestCase[]
  testResults TestResult[]

  @@index([userId, createdAt])
}

model Iteration {
  id              String   @id @default(cuid())
  runId           String
  iterationIndex  Int // 1-based
  inputCode       String // code fed into this iteration
  analyzerOutput  Json
  criticOutput    Json
  improverOutput  Json
  // Per-iteration verdict — set only on legacy/fallback iterations. Test-driven runs evaluate once at the end (Run.finalEvaluation).
  evaluatorOutput Json?
  overallScore    Int? // from evaluatorOutput.scores.overall; null on test-driven iterations
  // This iteration's measured pass-rate (0–100); drives termination. Null when the sandbox was unavailable or on legacy runs.
  testPassRate    Int?
  createdAt       DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, iterationIndex])
  @@index([runId])
}

model TestCase {
  id             String     @id @default(cuid())
  runId          String
  name           String // short human label, e.g. "edge: n=1"
  input          String // piped to the program's stdin
  expectedOutput String // compared against stdout (line-trimmed)
  source         TestSource
  // Optional per-case overrides; null means use env.SANDBOX_TIMEOUT_MS /
  // a default memory cap. Most CP problems don't need per-case tuning.
  timeLimitMs    Int?
  memoryLimitMb  Int?
  createdAt      DateTime   @default(now())

  run     Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  results TestResult[]

  @@index([runId])
}

model TestResult {
  id           String   @id @default(cuid())
  testCaseId   String
  runId        String // denormalized so listings don't have to join TestCase
  iterationId  String? // iteration that produced this result; null for run-level results from the execute-tests endpoint
  passed       Boolean
  actualOutput String?
  stderr       String?
  exitCode     Int?
  durationMs   Int?
  // 'ok' | 'wrong_answer' | 'timeout' | 'runtime_error' | 'compile_error' | 'sandbox_error'. String, not enum, so new reasons need no migration.
  errorReason  String?
  createdAt    DateTime @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  run      Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([testCaseId])
}

enum TestSource {
  generated
  manual
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
