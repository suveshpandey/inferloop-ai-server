# ─── Server ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://inferloop:inferloop@localhost:5432/inferloop

# ─── Auth (JWT access + DB-backed refresh tokens) ───────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── CORS (frontend origin) ─────────────────────────────────────────────
# Comma-separated list. Include localhost for local dev AND every deployed
# frontend origin (production + any preview URLs you want to whitelist).
CORS_ORIGIN=http://localhost:3000,https://inferloopai.vercel.app

# ─── LLM provider: ollama | gemini | euri ───────────────────────────────
LLM_PROVIDER=ollama

# Ollama (local dev)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini (Google AI Studio direct)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Euri (api.euron.one — OpenAI-compatible gateway to gpt / gemini / claude / qwen / …)
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=gpt-5.3-instant

# ─── Vercel Sandbox (required for test execution) ───────────────────────
# Get token/team/project from the Vercel dashboard.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Paste the ID printed by `pnpm tsx src/scripts/build-cpp-snapshot.ts`.
# Needed only for C++ runs (gives fast cold start via prebuilt g++ image).
VERCEL_CPP_SNAPSHOT_ID=

# Sandbox tuning (defaults shown)
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MAX_OUTPUT_KB=64

# ─── Test generator ─────────────────────────────────────────────────────
# Max cases generated per run. ~6 is the tested sweet spot.
MAX_GENERATED_CASES=6

# ─── Rate limits ────────────────────────────────────────────────────────
# Review limits apply only when LLM_PROVIDER is gemini or euri (skipped for ollama).
# Execute-tests limits always apply (Vercel sandbox quota).
RATE_LIMIT_REVIEW_PER_MIN=2
RATE_LIMIT_REVIEW_PER_DAY=5
RATE_LIMIT_EXECUTE_PER_MIN=5
RATE_LIMIT_EXECUTE_PER_DAY=30
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_SIGNUP_PER_MIN=5
