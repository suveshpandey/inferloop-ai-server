  PORT=3001
  NODE_ENV=development

  # LLM provider: ollama | gemini | euri
  LLM_PROVIDER=ollama

  # Ollama (local)
  OLLAMA_HOST=http://localhost:11434
  OLLAMA_MODEL=qwen2.5-coder:7b

  # Gemini (Google AI Studio)
  GEMINI_API_KEY=
  GEMINI_MODEL=gemini-2.5-flash

  # Euri (api.euron.one — OpenAI-compatible gateway to gpt, gemini, claude, qwen, etc.)
  EURI_API_KEY=
  EURI_BASE_URL=https://api.euron.one/api/v1/euri
  EURI_MODEL=gpt-5.3-instant
